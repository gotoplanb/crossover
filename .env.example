# Local dev points at the compose Postgres on 5433, which uses trust auth on
# loopback only — hence no password here, and no credential committed to a public
# repo. Heroku injects its own DATABASE_URL (postgres://…), which
# config/settings.py normalizes for asyncpg.
DATABASE_URL=postgresql+asyncpg://crossover@localhost:5433/crossover

# Marvel developer credentials — free at https://developer.marvel.com.
# Without both, nothing syncs and every issue renders as "not on Marvel
# Unlimited". That is the honest failure mode: a guessed id opens the wrong
# comic rather than erroring (Gate B).
MARVEL_PUBLIC_KEY=
MARVEL_PRIVATE_KEY=

# Public HTTPS origin. Also the OAuth issuer, so it must match what the Claude
# connector actually hits.
CROSSOVER_PUBLIC_URL=http://localhost:8020

# One password per reader, named by their handle. There is deliberately no
# master admin key: admin is a per-reader flag, so each admin has their own
# credential and revoking a session revokes their curation access with it.
# Shared secret required to create an account. Readers register themselves at
# /ui/register and their password is argon2id-hashed into the database, so
# admitting somebody no longer means a deploy.
#
# LEAVING THIS UNSET CLOSES REGISTRATION — it does not open it. The app writes
# to your database and spends a rate-limited third-party quota on every shelf
# lookup, so forgetting to configure the gate must not be the mistake that opens
# the door. Rotate it to stop admitting people.
CROSSOVER_INVITE_CODE=

# Passwords are never read from the environment. A reader either has an argon2
# hash in the database or has no way in, and the way in is minted:
#   .venv/bin/python -m scripts.cli seed dave@example.com --handle dave --admin --set-password
#   .venv/bin/python -m scripts.cli set-password dave
#   .venv/bin/python -m scripts.cli reset-link dave --issued-by dave

# OpenTelemetry -> Watchtower's Alloy collector, which fans out to Tempo
# (traces) and Loki (logs). Defaults suit a local Watchtower on the host; from
# inside a container use host.docker.internal:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=crossover
# Set false to run with no telemetry export at all (tests do this).
OTEL_ENABLED=true

# Set true when serving over HTTPS so the session cookie carries Secure.
UI_COOKIE_SECURE=false
