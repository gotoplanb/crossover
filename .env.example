# Local dev points at the compose Postgres on 5433, which uses trust auth on
# loopback only — hence no password here, and no credential committed to a public
# repo. Heroku injects its own DATABASE_URL (postgres://…), which
# config/settings.py normalizes for asyncpg.
DATABASE_URL=postgresql+asyncpg://crossover@localhost:5433/crossover

# Marvel developer credentials — free at https://developer.marvel.com.
# Without both, nothing syncs and every issue renders as "not on Marvel
# Unlimited". That is the honest failure mode: a guessed id opens the wrong
# comic rather than erroring (Gate B).
MARVEL_PUBLIC_KEY=
MARVEL_PRIVATE_KEY=

# Public HTTPS origin. Also the OAuth issuer, so it must match what the Claude
# connector actually hits.
CROSSOVER_PUBLIC_URL=http://localhost:8020

# Gates the curation views and OAuth consent approval. REQUIRED — the app
# refuses to start without it, deliberately: this repo is public, so a default
# would be a published credential. Generate one with `make admin-key`.
CROSSOVER_ADMIN_KEY=

# OpenTelemetry -> Watchtower's Alloy collector, which fans out to Tempo
# (traces) and Loki (logs). Defaults suit a local Watchtower on the host; from
# inside a container use host.docker.internal:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=crossover
# Set false to run with no telemetry export at all (tests do this).
OTEL_ENABLED=true

# Set true when serving over HTTPS so the session cookie carries Secure.
UI_COOKIE_SECURE=false
